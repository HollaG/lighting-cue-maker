// CueSketch v2 schema, generated from the draw.io "version 2" page (2026-11-08).
// Paste into https://dbdiagram.io
// Squares in draw.io = tables here. Rounded rectangles (JSON structs) = jsonb columns,
// with their shape described in the column note.
// Table names are snake_case plural (GORM default); the diagram's names are in each table note.

Project CueSketch_v2 {
  database_type: 'PostgreSQL'
  Note: 'Postgres schema "v2". v1 tables stay in "public", untouched.'
}

Enum v2.option_set_selection_type {
  SINGLE
  MULTI
  BOOL
}

Enum v2.option_set_type {
  Intensity
  Colour
  Position
  Custom [note: 'Pattern and Movement selectables use Custom (simple dropdown). More types can be added.']
}

// ---------------------------------------------------------------- library

Table v2.fixture_templates {
  uuid uuid [pk]
  name varchar
  manufacturer varchar
  model varchar
  type varchar [note: 'FixtureType: par, bar, moving head, etc.']
  channels jsonb [note: '''
    Channel[]
    Channel {
      uuid: string        // generated by code, not psql
      name: string
      defaultValue: int   // defaults to 0
      preset: ChannelPreset { type?: ChannelType }  // undefined for custom
      capabilities: ChannelCapability[] { from: int, to: int, description: string }
      type: ChannelType
      role: ChannelRole   // FINE | COARSE
    }
  ''']
  modes jsonb [note: '''
    Mode[]  (only one supported for now)
    Mode {
      uuid: string        // generated by code
      name: string
      channelIds: string[]
      heads: Head[] { name: string, channelIndexes: int[] }  // indexes into the mode
    }
  ''']
  properties jsonb [note: '''
    PhysicalProperties {
      columns: int, rows: int
      maxPan: int, maxTilt: int
      minBeamAngle: float, maxBeamAngle: float  // identical if no zoom
      brightnessModifier: int                   // CueSketch-only, visualiser
    }
  ''']
  model_url varchar [note: 'link to the 3D model']
  import_type varchar [note: 'ConsoleType']
  raw_source text
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: FixtureTemplates. Agnostic (CueSketch-specific) template. Global library shared by all events. Copied into events.fixture_templates as JSON, so library edits never change an event; nothing in an event points at this table.'
}

// ---------------------------------------------------------------- event setup (LD)

Table v2.events {
  uuid uuid [pk]
  name varchar
  description text
  external_link varchar
  metadata jsonb [note: 'Object']
  fixture_templates jsonb [note: 'FixtureTemplate[] (or a map). Copies of fixture_templates rows; same shape.']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: Events'
}

Table v2.patched_fixtures {
  uuid uuid [pk]
  event_id uuid
  fixture_template_id varchar [note: 'FixtureTemplate.uuid of the copy inside events.fixture_templates (JSON), never the library table. Not a DB-enforced FK.']
  mode_id varchar [note: 'Mode.uuid inside the template JSON']
  name varchar [note: '"unused ig"']
  pos_x float8
  pos_y float8
  pos_z float8
  rot_x float8
  rot_y float8
  rot_z float8
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: PatchedFixtures. A "real" fixture in the world. "Maybe it can be saved as JSON".'
}

Table v2.fixture_groups {
  uuid uuid [pk]
  event_id uuid
  name varchar
  description text
  fixture_ids jsonb [note: 'String[]  (patched_fixtures.uuid). Membership.']
  grid jsonb [note: '''
    Grid {
      cols: int, rows: int
      cells: GroupGridCell[] { fixtureId: string, head: int, col: int, row: int }
    }
    cells[] MUST be kept in sync with fixture_ids.
  ''']
  sort_order int
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: FixtureGroups.'
}

Table v2.option_sets {
  uuid uuid [pk]
  fixture_group_id uuid
  name varchar
  description text
  sort_order int [note: 'order of appearance']
  priority int [note: 'application order (TODO in the design)']
  selection_type v2.option_set_selection_type
  type v2.option_set_type
  selectables jsonb [note: '''
    Selectable[]   (selectable order = position in this array)
    Selectable {
      uuid: string
      name: string
      fixtureIds: string[] | "all"   // default "all"
      type: SelectableType  // AppPresetIntensity | AppPresetColour | AppPresetPosition
                            // | AppCustom | AppPresetEffectPattern | AppPresetEffectMovement
      // intensity
      percent: int
      // colour
      colour: Colour { name: string, hex: string,
                       mix?: { r?, g?, b?, white?, amber?, uv?, lime?, indigo?: int } }
      // position
      positions: { [fixtureId]: Position { pan: int, tilt: int, zoom?: int, focus?: int } }  // 0-65535
      // custom
      common: CommonChannelValue[] { type: ChannelType, fine: bool, value: int 0-255 }
      individual: { [fixtureId]: IndividualChannelValue[] { channelId: string, value: int 0-255 } }
      // pattern
      effect: PatternEffect, colours: Colour[]
      blendMode: BlendMode = "normal", colourMode: ColourMode = "rgb"
      stepDuration: int, fadeInDuration: int = 0, fadeOutDuration: int = 0
      // movement
      effect: MovementEffect
      width: int, height: int, offsetX: int, offsetY: int
      loopTime: int = 20s, spread: int
      fixtureOverrides?: { [fixtureId]: MovementFixtureOverride { startOffset?: float, reverse?: bool } }
    }
  ''']
  default_selectable_ids jsonb [note: 'String[]. Copied into a cue when it is created.']
  required bool [note: 'must be selected, or can be empty']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: OptionSets. A group of Selectables (options).'
}

Table v2.visualisers {
  uuid uuid [pk]
  event_id uuid
  config3d jsonb [note: 'v1: { haze: 0-1, ambientLight: 0-1 }']
  objects3d jsonb [note: 'Object[]. v1: cuboid { position, rotation, size, color } | default_human { position, rotation }']
  default_camera_view jsonb [note: 'v1: { position: [x,y,z], target: [x,y,z], fov }']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: Visualisers. 3D only; no 2D data.'
}

// ---------------------------------------------------------------- show content (users)

Table v2.items {
  uuid uuid [pk]
  event_id uuid
  name varchar
  comments text
  raw_lyrics text [note: 'Source of truth for cue order (cue markers).']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: Items. No order field yet (deferred).'
}

Table v2.cues {
  uuid uuid [pk]
  item_id uuid
  comments text
  transition jsonb [note: 'CueTransition']
  mode varchar [note: 'CueMode']
  active_fixture_group_ids jsonb [note: 'String[]']
  selectable_ids jsonb [note: 'String[] (Selectable.uuid inside option_sets.selectables)']
  overrides jsonb [note: '{ [fixtureId]: { [channelId]: int } }']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: Cue. No order field: position comes from items.raw_lyrics.'
}

Table v2.alternate_cues {
  uuid uuid [pk]
  cue_uuid uuid
  comments text
  transition jsonb [note: 'CueTransition']
  mode varchar [note: 'CueMode']
  active_fixture_group_ids jsonb [note: 'String[]']
  selectable_ids jsonb [note: 'String[]']
  overrides jsonb [note: '{ [fixtureId]: { [channelId]: int } }']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'Diagram: AlternateCue'
}

// ---------------------------------------------------------------- relationships (real FKs only)

Ref: v2.visualisers.event_id > v2.events.uuid
Ref: v2.patched_fixtures.event_id > v2.events.uuid
Ref: v2.fixture_groups.event_id > v2.events.uuid
Ref: v2.option_sets.fixture_group_id > v2.fixture_groups.uuid
Ref: v2.items.event_id > v2.events.uuid
Ref: v2.cues.item_id > v2.items.uuid
Ref: v2.alternate_cues.cue_uuid > v2.cues.uuid

// IDs that live inside JSON can't be FKs, so they aren't drawn:
//   patched_fixtures.fixture_template_id / mode_id -> events.fixture_templates JSON
//   fixture_groups.fixture_ids / grid.cells[].fixtureId -> patched_fixtures.uuid
//   cues.active_fixture_group_ids -> fixture_groups.uuid
//   cues.selectable_ids -> option_sets.selectables[].uuid
//   cues.overrides keys -> patched_fixtures.uuid / channel uuids
